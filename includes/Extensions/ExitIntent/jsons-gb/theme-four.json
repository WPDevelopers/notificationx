{
 "title": "Free shipping announcement",
 "content": "<!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"44px\",\"right\":\"40px\",\"bottom\":\"40px\",\"left\":\"40px\"},\"blockGap\":\"16px\"},\"border\":{\"radius\":\"16px\"},\"color\":{\"gradient\":\"linear-gradient(135deg,#0f766e 0%,#16a34a 100%)\",\"text\":\"#ffffff\"}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"560px\"}} -->\n<div class=\"wp-block-group has-text-color has-background\" style=\"border-radius:16px;color:#ffffff;background:linear-gradient(135deg,#0f766e 0%,#16a34a 100%);padding-top:44px;padding-right:40px;padding-bottom:40px;padding-left:40px\"><!-- wp:heading {\"textAlign\":\"center\",\"style\":{\"typography\":{\"fontSize\":\"32px\",\"fontWeight\":\"800\",\"lineHeight\":\"1.15\"},\"color\":{\"text\":\"#ffffff\"}}} -->\n<h2 class=\"wp-block-heading has-text-align-center has-text-color\" style=\"color:#ffffff;font-size:32px;font-weight:800;line-height:1.15\">Free shipping on orders over $50</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"align\":\"center\",\"style\":{\"color\":{\"text\":\"#dcfce7\"},\"typography\":{\"fontSize\":\"17px\"}}} -->\n<p class=\"has-text-align-center has-text-color\" style=\"color:#dcfce7;font-size:17px\">Add one more treat to your basket and we’ll ship the whole order for free.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\",\"flexWrap\":\"wrap\"},\"style\":{\"spacing\":{\"blockGap\":\"12px\",\"margin\":{\"top\":\"8px\"}}}} -->\n<div class=\"wp-block-buttons\" style=\"margin-top:8px\"><!-- wp:button {\"style\":{\"color\":{\"background\":\"#ffffff\",\"text\":\"#0f766e\"},\"border\":{\"radius\":\"10px\"},\"spacing\":{\"padding\":{\"top\":\"13px\",\"bottom\":\"13px\",\"left\":\"24px\",\"right\":\"24px\"}},\"typography\":{\"fontSize\":\"16px\",\"fontWeight\":\"700\"}}} -->\n<div class=\"wp-block-button has-custom-font-size\" style=\"font-size:16px;font-weight:700\"><a class=\"wp-block-button__link has-text-color has-background wp-element-button\" href=\"#\" style=\"border-radius:10px;color:#0f766e;background-color:#ffffff;padding-top:13px;padding-right:24px;padding-bottom:13px;padding-left:24px\">Continue shopping</a></div>\n<!-- /wp:button -->\n\n<!-- wp:button {\"className\":\"is-style-outline\",\"style\":{\"color\":{\"text\":\"#ffffff\",\"background\":\"transparent\"},\"border\":{\"radius\":\"10px\",\"width\":\"2px\",\"color\":\"#ffffff\"},\"spacing\":{\"padding\":{\"top\":\"11px\",\"bottom\":\"11px\",\"left\":\"24px\",\"right\":\"24px\"}},\"typography\":{\"fontSize\":\"16px\",\"fontWeight\":\"700\"}}} -->\n<div class=\"wp-block-button has-custom-font-size is-style-outline\" style=\"font-size:16px;font-weight:700\"><a class=\"wp-block-button__link has-text-color has-background has-border-color wp-element-button\" href=\"#\" style=\"border-color:#ffffff;border-width:2px;border-radius:10px;color:#ffffff;background-color:transparent;padding-top:11px;padding-right:24px;padding-bottom:11px;padding-left:24px\">View cart</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->\n\n<!-- wp:paragraph {\"align\":\"center\",\"style\":{\"color\":{\"text\":\"#bbf7d0\"},\"typography\":{\"fontSize\":\"13px\"}}} -->\n<p class=\"has-text-align-center has-text-color\" style=\"color:#bbf7d0;font-size:13px\">Offer ends Sunday at midnight.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n"
}
