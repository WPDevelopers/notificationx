 "title": "Coupon code",
 "content": "<!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"40px\",\"right\":\"40px\",\"bottom\":\"32px\",\"left\":\"40px\"},\"blockGap\":\"16px\"},\"border\":{\"radius\":\"16px\"},\"color\":{\"background\":\"#ffffff\",\"text\":\"#1f2937\"}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"520px\"}} -->\n<div class=\"wp-block-group has-text-color has-background\" style=\"border-radius:16px;color:#1f2937;background-color:#ffffff;padding-top:40px;padding-right:40px;padding-bottom:32px;padding-left:40px\"><!-- wp:heading {\"textAlign\":\"center\",\"style\":{\"typography\":{\"fontSize\":\"30px\",\"fontWeight\":\"800\",\"lineHeight\":\"1.15\"}}} -->\n<h2 class=\"wp-block-heading has-text-align-center\" style=\"font-size:30px;font-weight:800;line-height:1.15\">Wait! Here’s 10% off</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"align\":\"center\",\"style\":{\"color\":{\"text\":\"#4b5563\"},\"typography\":{\"fontSize\":\"16px\"}}} -->\n<p class=\"has-text-align-center has-text-color\" style=\"color:#4b5563;font-size:16px\">Finish your order today and save on everything in your basket.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"style\":{\"border\":{\"color\":\"#7c3aed\",\"style\":\"dashed\",\"width\":\"2px\",\"radius\":\"10px\"},\"spacing\":{\"padding\":{\"top\":\"12px\",\"bottom\":\"12px\"}},\"color\":{\"background\":\"#f5f3ff\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group has-border-color has-background\" style=\"border-color:#7c3aed;border-style:dashed;border-width:2px;border-radius:10px;background-color:#f5f3ff;padding-top:12px;padding-bottom:12px\"><!-- wp:paragraph {\"align\":\"center\",\"style\":{\"color\":{\"text\":\"#5b21b6\"},\"typography\":{\"fontSize\":\"24px\",\"fontWeight\":\"700\",\"letterSpacing\":\"4px\"}}} -->\n<p class=\"has-text-align-center has-text-color\" style=\"color:#5b21b6;font-size:24px;font-weight:700;letter-spacing:4px\">STAY10</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"width\":100,\"style\":{\"color\":{\"background\":\"#7c3aed\",\"text\":\"#ffffff\"},\"border\":{\"radius\":\"10px\"},\"spacing\":{\"padding\":{\"top\":\"14px\",\"bottom\":\"14px\"}},\"typography\":{\"fontSize\":\"16px\",\"fontWeight\":\"700\"}}} -->\n<div class=\"wp-block-button has-custom-width wp-block-button__width-100 has-custom-font-size\" style=\"font-size:16px;font-weight:700\"><a class=\"wp-block-button__link has-text-color has-background wp-element-button\" href=\"#\" style=\"border-radius:10px;color:#ffffff;background-color:#7c3aed;padding-top:14px;padding-bottom:14px\">Use my 10% off</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->\n\n<!-- wp:paragraph {\"align\":\"center\",\"style\":{\"color\":{\"text\":\"#6b7280\"},\"typography\":{\"fontSize\":\"14px\"}}} -->\n<p class=\"has-text-align-center has-text-color\" style=\"color:#6b7280;font-size:14px\"><a href=\"#nx-close\">No thanks, I’ll pay full price</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n"
