 "title": "Image and text",
 "content": "<!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0\",\"right\":\"0\",\"bottom\":\"0\",\"left\":\"0\"}},\"border\":{\"radius\":\"16px\"},\"color\":{\"background\":\"#ffffff\",\"text\":\"#1f2937\"}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"760px\"}} -->\n<div class=\"wp-block-group has-text-color has-background\" style=\"border-radius:16px;color:#1f2937;background-color:#ffffff;padding-top:0;padding-right:0;padding-bottom:0;padding-left:0\"><!-- wp:columns {\"verticalAlignment\":\"center\",\"style\":{\"spacing\":{\"blockGap\":{\"top\":\"0\",\"left\":\"0\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"}}}} -->\n<div class=\"wp-block-columns are-vertically-aligned-center\" style=\"margin-top:0;margin-bottom:0\"><!-- wp:column {\"verticalAlignment\":\"center\",\"width\":\"42%\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\" style=\"flex-basis:42%\"><!-- wp:image {\"aspectRatio\":\"1\",\"scale\":\"cover\",\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-full\"><img src=\"{{NX_IMG}}/exit-intend-theme-six.jpg\" alt=\"Shopper in a red coat holding shopping bags\" style=\"aspect-ratio:1;object-fit:cover\"/></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"verticalAlignment\":\"center\",\"width\":\"58%\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"36px\",\"right\":\"36px\",\"bottom\":\"36px\",\"left\":\"36px\"},\"blockGap\":\"14px\"}}} -->\n<div class=\"wp-block-column is-vertically-aligned-center\" style=\"padding-top:36px;padding-right:36px;padding-bottom:36px;padding-left:36px;flex-basis:58%\"><!-- wp:paragraph {\"style\":{\"color\":{\"text\":\"#dc2626\"},\"typography\":{\"fontSize\":\"13px\",\"fontWeight\":\"700\",\"letterSpacing\":\"3px\",\"textTransform\":\"uppercase\"}}} -->\n<p class=\"has-text-color\" style=\"color:#dc2626;font-size:13px;font-weight:700;letter-spacing:3px;text-transform:uppercase\">New season</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"style\":{\"typography\":{\"fontSize\":\"30px\",\"fontWeight\":\"800\",\"lineHeight\":\"1.15\"}}} -->\n<h2 class=\"wp-block-heading\" style=\"font-size:30px;font-weight:800;line-height:1.15\">Don’t leave empty-handed</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"style\":{\"color\":{\"text\":\"#4b5563\"},\"typography\":{\"fontSize\":\"16px\"}}} -->\n<p class=\"has-text-color\" style=\"color:#4b5563;font-size:16px\">Our new arrivals just landed. Take a look before you go — members get free returns.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"style\":{\"color\":{\"background\":\"#dc2626\",\"text\":\"#ffffff\"},\"border\":{\"radius\":\"999px\"},\"spacing\":{\"padding\":{\"top\":\"12px\",\"bottom\":\"12px\",\"left\":\"28px\",\"right\":\"28px\"}},\"typography\":{\"fontSize\":\"16px\",\"fontWeight\":\"700\"}}} -->\n<div class=\"wp-block-button has-custom-font-size\" style=\"font-size:16px;font-weight:700\"><a class=\"wp-block-button__link has-text-color has-background wp-element-button\" href=\"#\" style=\"border-radius:999px;color:#ffffff;background-color:#dc2626;padding-top:12px;padding-right:28px;padding-bottom:12px;padding-left:28px\">Shop new arrivals</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group -->\n"
