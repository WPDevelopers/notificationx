{
    "compilerOptions": {
        "outDir": "./nxbuild/",
        "target": "es5",
        "lib": [
            "dom",
            "dom.iterable",
            "esnext",
            "es2015",
            "es2016",
            "es2018"
        ],
        "jsx": "react",
        "module": "esnext",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "allowJs": true,
        "allowSyntheticDefaultImports": true,
        "noImplicitAny": false,
        "moduleResolution": "node",
        "noUnusedLocals": false,
        "sourceMap": true,
        "types": ["node"],
        "skipLibCheck": true
    },
    "include": [
        "nxdev/**/*",
        "blocks/**/*"
    ],
    "exclude": [
        "node_modules",
        "assets",
        "nxbuild",
        "vendor",
        "blocks/*/index.js",
        "blocks/controls/dist",
        "blocks/controls/webpack.config.js"
    ]
}
